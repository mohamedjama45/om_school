<?xml version='1.0' encoding='utf-8' ?>
<odoo>


    <record id="class_tree" model="ir.ui.view">
        <field name="name">class.tree</field>
         <field name="model">school1.class</field>
        <field name="arch" type="xml">
             <tree>
                 <field name="name"/>
             </tree>
        </field>
    </record>




         <!--Classes Form-->

    <record id="class_form" model="ir.ui.view">
      <field name="name">class.form</field>
       <field name="model">school1.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>

                        <group>
                           <field name="name"/>
                        </group>



                    </group>
                </sheet>
                 <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                 </div>
            </form>
        </field>
    </record>


             <!--Classes Action-->

   <record id="class_action" model="ir.actions.act_window">
       <field name="name">Manage Classes</field>
       <field name="type">ir.actions.act_window</field>
        <field name="res_model">school1.class</field>
        <field name="view_mode">tree,kanban,form</field>
   </record>



    <menuitem
        id="school_root"
        name="Iftin School"
        sequence="1"/>

    <menuitem
        id="school_class"
        name="Classes"
        parent="school_root"
        action="class_action"
        sequence="1"/>






</odoo>