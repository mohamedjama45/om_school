<?xml version='1.0'  encoding='utf-8' ?>
<odoo>


    <record id="teacher_tree" model="ir.ui.view">
        <field name="name">teacher.tree</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <tree>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="class_id"/>
            </tree>
        </field>

    </record>


    <!--Student Form-->
    <record id="teacher_form" model="ir.ui.view">
        <field name="name">teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="class_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>

    </record>


    <record id="teacher_action" model="ir.actions.act_window">
        <field name="name">Manage Teachers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">tree,kanban,form</field>
    </record>


    <menuitem
            id="school_teacher"
            name="Teachers"
            parent="school_root"
            action="teacher_action"
            sequence="3"
    />


</odoo>